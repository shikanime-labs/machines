#!/bin/sh
# halogen-flash-server: source shipped as-is, comments stripped. The README is the documentation.
set -u
SYS="${HALOGEN_SYSFS:-/sys}"

wr() { { echo "$2" > "$1"; } 2>/dev/null; }

devices() {
  for d in "$SYS"/class/drm/card*/device; do
    [ -e "$d/pp_dpm_fclk" ] && [ -e "$d/power_dpm_force_performance_level" ] || continue
    echo "$d"
  done | sort -u
}

soc_gpu() {

  for p in "$SYS"/class/kfd/kfd/topology/nodes/*/properties; do
    [ -r "$p" ] || continue
    v=$(awk '$1 == "gfx_target_version" {print $2; exit}' "$p" 2>/dev/null)
    case "$v" in 1105[0-9][0-9]) ;; *) continue ;; esac
    minor=$(awk '$1 == "drm_render_minor" {print $2; exit}' "$p" 2>/dev/null)
    dom=$(awk '$1 == "domain" {print $2; exit}' "$p" 2>/dev/null)
    loc=$(awk '$1 == "location_id" {print $2; exit}' "$p" 2>/dev/null)
    want=""; addr=""
    case "$minor" in ''|*[!0-9]*) ;; *) [ -e "$SYS/class/drm/renderD$minor/device" ] && want=$(readlink -f "$SYS/class/drm/renderD$minor/device" 2>/dev/null) ;; esac
    case "$dom:$loc" in *[!0-9:]*|:*|*:) ;; *) addr=$(printf '%04x:%02x:%02x.%x' "$dom" $((loc >> 8)) $(((loc >> 3) & 31)) $((loc & 7))) ;; esac
    for d in "$SYS"/class/drm/card*/device; do
      [ -e "$d" ] || continue
      real=$(readlink -f "$d" 2>/dev/null)
      if { [ -n "$want" ] && [ "$real" = "$want" ]; } || { [ -n "$addr" ] && [ "${real##*/}" = "$addr" ]; }; then
        echo "$d"; return 0
      fi
    done
  done
  return 0
}

held() {
  perf=$(cat "$1/power_dpm_force_performance_level" 2>/dev/null) || perf=""
  fclk=$(cat "$1/pp_dpm_fclk" 2>/dev/null) || fclk=""
  [ -n "$perf" ] && [ -n "$fclk" ] || return 2
  top=$(printf '%s\n' "$fclk" | grep . | tail -n 1)
  [ "$perf" = high ] && return 0
  [ "$perf" = manual ] || return 1
  [ "$(printf '%s\n' "$fclk" | grep -c '\*')" = 1 ] && [ "${top%\*}" != "$top" ]
}

hold_dev() {
  lvl=$(cat "$1/pp_dpm_fclk" 2>/dev/null | grep . | tail -n 1 | cut -d: -f1)
  perf=$(cat "$1/power_dpm_force_performance_level" 2>/dev/null) || perf=""
  [ -n "$lvl" ] && [ -n "$perf" ] || return 2
  if wr "$1/power_dpm_force_performance_level" manual && wr "$1/pp_dpm_fclk" "$lvl"; then

    t=0; until held "$1" || [ "$t" -ge 300 ]; do sleep 0.1; t=$((t + 1)); done
    if held "$1"; then
      echo "halogen-fabric-clock: $1: held at level $lvl ($(cat "$1/pp_dpm_fclk" 2>/dev/null | grep . | tail -n 1 | awk '{print $2}'))"
      return 0
    fi
  fi
  echo "halogen-fabric-clock: $1: could not hold it (level $lvl)" >&2
  return 1
}

do_hold() {
  n=0; soc=""

  while [ "$n" -lt 60 ]; do
    soc=$(soc_gpu)
    [ -n "$soc" ] && break
    [ -d "$SYS/class/kfd/kfd/topology/nodes" ] || [ -z "$(devices)" ] || break
    sleep 1; n=$((n + 1))
  done
  if [ -n "$soc" ]; then
    hold_dev "$soc"; s=$?
    [ "$s" = 2 ] && echo "halogen-fabric-clock: $soc (the SoC's GPU): its clock controls cannot be read, so it cannot be held" >&2
    [ "$s" = 0 ]; return
  fi
  [ -n "$(devices)" ] || { echo "halogen-fabric-clock: no amdgpu device with a fabric clock control (pp_dpm_fclk) under $SYS/class/drm" >&2; return 1; }
  echo "halogen-fabric-clock: the GPU topology names no SoC GPU here, so every AMD device that can be read is held"
  rc=0; held_n=0; unknown=""
  for d in $(devices); do
    hold_dev "$d"; s=$?
    case "$s" in
      0) held_n=$((held_n + 1)) ;;
      2) unknown="$unknown $d" ;;
      *) rc=1 ;;
    esac
  done
  [ -n "$unknown" ] && echo "halogen-fabric-clock: skipped, unreadable:$unknown"
  [ "$held_n" -gt 0 ] || { echo "halogen-fabric-clock: nothing that can be read was held" >&2; rc=1; }
  return "$rc"
}

do_release() {
  soc=$(soc_gpu)
  if [ -n "$soc" ]; then set -- "$soc"; else set -- $(devices); fi
  rc=0
  for d in "$@"; do
    held "$d"; [ "$?" = 2 ] && continue
    if wr "$d/power_dpm_force_performance_level" auto; then echo "halogen-fabric-clock: $d: released (auto)"
    else echo "halogen-fabric-clock: $d: could not release it" >&2; rc=1; fi
  done
  return "$rc"
}

do_status() {
  soc=$(soc_gpu)
  if [ -n "$soc" ]; then
    held "$soc"; s=$?
    case "$s" in
      0) echo "$soc (the SoC's GPU): held ($(cat "$soc/power_dpm_force_performance_level" 2>/dev/null))"; return 0 ;;
      2) echo "$soc (the SoC's GPU): unreadable, so it cannot be told"; return 1 ;;
      *) echo "$soc (the SoC's GPU): NOT held ($(cat "$soc/power_dpm_force_performance_level" 2>/dev/null))"; return 1 ;;
    esac
  fi
  [ -n "$(devices)" ] || { echo "halogen-fabric-clock: no amdgpu device with a fabric clock control"; return 1; }
  rc=0; held_n=0
  for d in $(devices); do
    held "$d"; s=$?
    case "$s" in
      0) echo "$d: held ($(cat "$d/power_dpm_force_performance_level" 2>/dev/null))"; held_n=$((held_n + 1)) ;;
      2) echo "$d: unreadable, skipped (a suspended device answers EBUSY)" ;;
      *) echo "$d: NOT held ($(cat "$d/power_dpm_force_performance_level" 2>/dev/null))"; rc=1 ;;
    esac
  done
  [ "$held_n" -gt 0 ] || rc=1
  return "$rc"
}

case "${1:-status}" in
  hold) do_hold; exit ;;
  release) do_release; exit ;;
  status) do_status; exit ;;
  *) echo "usage: halogen-fabric-clock hold | release | status" >&2; exit 2 ;;
esac
