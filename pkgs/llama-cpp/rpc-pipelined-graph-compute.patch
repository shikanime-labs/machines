+// Async graph compute. One in-flight graph per device; later
+// commands on the same device flush it before touching buffers.
+struct async_graph {
+    std::thread worker;
+    bool busy = false;
+};
+static std::map<uint32_t, async_graph> async_graphs;
+static std::mutex async_graphs_mutex;
+
+static void flush_async_graph(uint32_t device) {
+    std::lock_guard<std::mutex> lk(async_graphs_mutex);
+    auto it = async_graphs.find(device);
+    if (it != async_graphs.end() && it->second.busy) {
+        it->second.worker.join();
+        it->second.busy = false;
+    }
+}
+
 bool rpc_server::get_tensor(const rpc_msg_get_tensor_req & request, std::vector<uint8_t> & response) {
+    // logits read = compute must be done; single backend in practice, flush all
+    for (uint32_t d = 0; d < backends.size(); d++) { flush_async_graph(d); }
     struct ggml_init_params params {
         /*.mem_size   =*/ ggml_tensor_overhead(),
         /*.mem_buffer =*/ NULL,
@@ -1748,9 +1769,16 @@ bool rpc_server::graph_compute(const std::vector<uint8_t> & input) {
             graph->use_counts[hash_pos] = tensor_ptrs.at(id)->use_count;
         }
     }
-    std::lock_guard<std::mutex> lock(compute_mutex);
-    ggml_status status = ggml_backend_graph_compute(backends[device], graph);
-    GGML_ASSERT(status == GGML_STATUS_SUCCESS && "Unsuccessful graph computations are not supported with RPC");
+    flush_async_graph(device);
+    async_graphs_mutex.lock();
+    async_graph & ag = async_graphs[device];
+    ag.busy = true;
+    async_graphs_mutex.unlock();
+    ggml_backend_t backend = backends[device];
+    ag.worker = std::thread([backend, graph]() {
+        ggml_status status = ggml_backend_graph_compute(backend, graph);
+        GGML_ASSERT(status == GGML_STATUS_SUCCESS && "Unsuccessful graph computations are not supported with RPC");
+    });
     stored_graphs[device].graph = graph;
     return true;
 }
